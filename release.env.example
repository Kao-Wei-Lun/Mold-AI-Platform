COMPOSE_PROJECT_NAME=mold-ai-platform

# Replace every value marked CHANGE_ME before an external Demo release.
PUBLIC_WEB_DOMAIN=mold.example.com
PUBLIC_WEB_BASE_URL=https://mold.example.com
TLS_EMAIL=CHANGE_ME@example.com

POSTGRES_DB=mold_ai
POSTGRES_USER=mold_ai
POSTGRES_PASSWORD=CHANGE_ME-use-a-long-random-database-password

DJANGO_SECRET_KEY=CHANGE_ME-use-at-least-32-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mold.example.com,api,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://mold.example.com
APP_ENV=release
APP_VERSION=0.10.0-demo

DEMO_AUTH_MODE=required
DEMO_API_TOKEN=CHANGE_ME-use-at-least-32-random-characters
DEMO_API_TOKEN_SCOPES=public-demo:read,public-demo:write
DEMO_API_ACTOR_ID=controlled-demo-user

TRUST_PROXY_HEADERS=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# Recommended ChatGPT Demo path: keep MCP local and connect through Secure MCP Tunnel.
PUBLIC_MCP_BASE_URL=
SECURE_MCP_TUNNEL_ID=CHANGE_ME-after-tunnel-creation
MCP_AUTH_MODE=none
MCP_BEARER_TOKEN=
MCP_BIND_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-gateway:*
MCP_ALLOWED_ORIGINS=http://localhost:*

LLM_PROVIDER=deterministic-demo
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_CHARS=24000
OPENAI_MAX_CONCURRENCY=2
OPENAI_PROVIDER_PROFILE=openai-demo-public-v1
OPENAI_PROMPT_PROFILE=mold-assistant-grounded-v1
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
QDRANT_CAD_COLLECTION=cad-similarity-v1
QDRANT_KNOWLEDGE_COLLECTION=knowledge-text-demo-v1
SIMILARITY_INDEX_VERSION=cad-demo-v1
SIMILARITY_AUTO_INDEX=true
ARTIFACT_STORAGE_ROOT=/data/artifacts
