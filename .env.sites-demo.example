COMPOSE_PROJECT_NAME=mold-ai-platform-sites-demo
APP_VERSION=0.14.0-demo

POSTGRES_DB=mold_ai
POSTGRES_USER=mold_ai
POSTGRES_PASSWORD=GENERATED_AT_FIRST_START
DJANGO_SECRET_KEY=GENERATED_AT_FIRST_START
DEMO_AUTH_MODE=local
MCP_PLATFORM_SERVICE_TOKEN=GENERATED_AT_FIRST_START

# Legacy compatibility only. Leave empty for the local-account Sites experience.
DEMO_API_TOKEN=

# Optional until you create the OpenAI Secure MCP Tunnel in Platform settings.
SECURE_MCP_TUNNEL_ID=
MCP_HOST_PORT=8002

# Stable owner-only Sites origin. Replace this before starting the external Demo.
PUBLIC_WEB_ENTRY_BASE_URL=https://replace-with-your-private-site.invalid

# Keep deterministic-demo until a separate inference Project key and model are approved.
LLM_PROVIDER=deterministic-demo
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_CHARS=24000
OPENAI_MAX_CONCURRENCY=2
OPENAI_PROVIDER_PROFILE=openai-demo-public-v1
OPENAI_PROMPT_PROFILE=mold-assistant-grounded-v1
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
QDRANT_CAD_COLLECTION=cad-similarity-v1
QDRANT_KNOWLEDGE_COLLECTION=knowledge-text-demo-v1
SIMILARITY_INDEX_VERSION=cad-demo-v1
SIMILARITY_AUTO_INDEX=true
ARTIFACT_STORAGE_ROOT=/data/artifacts
