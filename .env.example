COMPOSE_PROJECT_NAME=mold-ai-platform

POSTGRES_DB=mold_ai
POSTGRES_USER=mold_ai
POSTGRES_PASSWORD=change-me-for-non-demo-use
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-before-external-access
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
APP_VERSION=0.1.0
ASSISTANT_LLM_PROVIDER=disabled

# Local development defaults. Use release.env.example for external access.
DEMO_AUTH_MODE=disabled
DEMO_API_TOKEN=
DEMO_API_TOKEN_SCOPES=public-demo:read,public-demo:write
DEMO_API_ACTOR_ID=local-demo-user
TRUST_PROXY_HEADERS=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
QDRANT_CAD_COLLECTION=cad-similarity-v1
QDRANT_KNOWLEDGE_COLLECTION=knowledge-text-demo-v1
SIMILARITY_INDEX_VERSION=cad-demo-v1
SIMILARITY_AUTO_INDEX=true
ARTIFACT_STORAGE_ROOT=/data/artifacts
MAX_CAD_UPLOAD_BYTES=209715200
MAX_KNOWLEDGE_UPLOAD_BYTES=5242880
MAX_HMI_UPLOAD_BYTES=10485760

VITE_API_BASE_URL=
PUBLIC_WEB_BASE_URL=http://localhost:5173
PUBLIC_MCP_BASE_URL=
SECURE_MCP_TUNNEL_ID=
MCP_AUTH_MODE=none
MCP_BEARER_TOKEN=
MCP_BIND_HOST=0.0.0.0
PLATFORM_API_TOKEN=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-gateway:*
MCP_ALLOWED_ORIGINS=http://localhost:*
