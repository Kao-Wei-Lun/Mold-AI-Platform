COMPOSE_PROJECT_NAME=mold-ai-platform

POSTGRES_DB=mold_ai
POSTGRES_USER=mold_ai
POSTGRES_PASSWORD=change-me-for-non-demo-use
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-before-external-access
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
APP_VERSION=0.1.0

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
QDRANT_CAD_COLLECTION=cad-similarity-v1
QDRANT_KNOWLEDGE_COLLECTION=knowledge-text-demo-v1
SIMILARITY_INDEX_VERSION=cad-demo-v1
SIMILARITY_AUTO_INDEX=true
ARTIFACT_STORAGE_ROOT=/data/artifacts
MAX_CAD_UPLOAD_BYTES=209715200
MAX_KNOWLEDGE_UPLOAD_BYTES=5242880

VITE_API_BASE_URL=
